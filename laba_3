CREATE TABLE reader(
    reader_id SERIAL PRIMARY KEY,
    fullname VARCHAR(100),
    phone_num VARCHAR(12)
);
CREATE TABLE loan(
    loan_id SERIAL PRIMARY KEY,
    reader_id SERIAL,
    FOREIGN KEY(reader_id) REFERENCES reader(reader_id),
    ISBN_book VARCHAR(20),  FOREIGN KEY (ISBN_book) REFERENCES book(ISBN_book),
    issue_day DATE,
    planned_return_day DATE,
    actual_return_day DATE NULL
);
CREATE TABLE book(
    ISBN_book VARCHAR(20) PRIMARY KEY,
    name_book VARCHAR(200),
    bday VARCHAR(4)
);
CREATE TABLE authorship(
    ISBN_book VARCHAR(200),FOREIGN KEY (ISBN_book) REFERENCES book(ISBN_book),
    author_id SERIAL,FOREIGN KEY (author_id) REFERENCES author(author_id)
);
CREATE TABLE author(
    author_id SERIAL PRIMARY KEY,
    fullname VARCHAR(200)
)

